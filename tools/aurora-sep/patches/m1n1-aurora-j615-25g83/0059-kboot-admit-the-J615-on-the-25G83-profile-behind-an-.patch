diff --git a/src/payload_profile.h b/src/payload_profile.h
index 272b5ed..7181709 100644
--- a/src/payload_profile.h
+++ b/src/payload_profile.h
@@ -6,6 +6,10 @@
 
 /* Legacy is a framebuffer fallback on 26.x. An exact experimental DT wins
  * regardless of archive order; other firmware never selects that profile.
+ * The J615 25G83 tree (experimental) ranks like the J613's: selecting it
+ * hands nothing over by itself, the display and GPU handoffs also need
+ * chosen.asahi,j615-25g83-experimental=1 (t8122_25g83.h), which m1n1.conf
+ * supplies only after the device trees have been ranked.
  */
 static inline int payload_profile_rank(const void *dt, bool os_26_6_2)
 {
@@ -15,7 +19,8 @@ static inline int payload_profile_rank(const void *dt, bool os_26_6_2)
     if (!profile)
         return 1;
     if (len != 4 || fdt32_ld(profile) != 1 || !os_26_6_2 ||
-        fdt_node_check_compatible(dt, 0, "apple,j613"))
+        (fdt_node_check_compatible(dt, 0, "apple,j613") &&
+         fdt_node_check_compatible(dt, 0, "apple,j615")))
         return 0;
     const fdt32_t *compat = fdt_getprop(dt, dcp, "apple,firmware-compat", &len);
     return compat && len == 12 && fdt32_ld(compat) == 26 &&
diff --git a/src/t8122_25g83.h b/src/t8122_25g83.h
new file mode 100644
index 0000000..6b3ea59
--- /dev/null
+++ b/src/t8122_25g83.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef T8122_25G83_H
+#define T8122_25G83_H
+
+#include <stdbool.h>
+#include "libfdt/libfdt.h"
+
+/*
+ * The J615 (M3 Air 15") runs the J613's 25G83 DCP, PMP and GPU images: Apple's
+ * 26.6.2 restore image has one entry for each, for both boards, and the J615's
+ * ADT display, PMP and GPU nodes equal the J613's but for phandles. It is
+ * still EXPERIMENTAL, not booted on a J615, so the display and GPU handoffs
+ * take a J615 only when its owner set chosen.asahi,j615-25g83-experimental=1
+ * in m1n1.conf. Linux checks the same switch again.
+ */
+#define T8122_25G83_J615_OPT_IN "asahi,j615-25g83-experimental"
+
+/* A J613, or a J615 with the opt-in. `dt` has /chosen set already. */
+static inline bool t8122_25g83_board(const void *dt)
+{
+    if (!fdt_node_check_compatible(dt, 0, "apple,j613"))
+        return true;
+    if (fdt_node_check_compatible(dt, 0, "apple,j615"))
+        return false;
+    int chosen = fdt_path_offset(dt, "/chosen"), len = 0;
+    const char *optin =
+        chosen < 0 ? NULL : fdt_getprop(dt, chosen, T8122_25G83_J615_OPT_IN, &len);
+    return optin && len == 2 && optin[0] == '1' && !optin[1];
+}
+
+#endif
diff --git a/tests/payload_profile_host.c b/tests/payload_profile_host.c
index a32f528..411cc43 100644
--- a/tests/payload_profile_host.c
+++ b/tests/payload_profile_host.c
@@ -3,9 +3,10 @@
 #include <stddef.h>
 #include <assert.h>
 #include "payload_profile.h"
+#include "t8122_25g83.h"
 int main(void)
 {
-    char legacy[2048], profile[2048];
+    char legacy[2048], profile[4096];
     assert(!fdt_create_empty_tree(legacy, sizeof(legacy)));
     assert(!fdt_setprop_string(legacy, 0, "compatible", "apple,j613"));
     assert(!fdt_open_into(legacy, profile, sizeof(profile)));
@@ -37,7 +38,27 @@ int main(void)
     assert(!fdt_setprop_u32(profile, dcp, "apple,j613-25g83-profile", 2));
     assert(payload_profile_rank(profile, true) == 0);
     assert(!fdt_setprop_u32(profile, dcp, "apple,j613-25g83-profile", 1));
+    /* The J615 25G83 tree (experimental) ranks like the J613's; other boards do not. */
     assert(!fdt_setprop_string(profile, 0, "compatible", "apple,j615"));
+    assert(payload_profile_rank(profile, true) == 2);
+    assert(payload_profile_rank(profile, false) == 0);
+    assert(!fdt_setprop_string(profile, 0, "compatible", "apple,j504"));
     assert(payload_profile_rank(profile, true) == 0);
+    /* Handoffs: a J613, or a J615 only with chosen.asahi,j615-25g83-experimental=1. */
+    assert(!fdt_setprop_string(profile, 0, "compatible", "apple,j613"));
+    assert(t8122_25g83_board(profile));
+    assert(!fdt_setprop_string(profile, 0, "compatible", "apple,j615"));
+    assert(!t8122_25g83_board(profile));
+    int chosen = fdt_add_subnode(profile, 0, "chosen");
+    assert(chosen >= 0);
+    assert(!t8122_25g83_board(profile));
+    assert(!fdt_setprop_string(profile, chosen, T8122_25G83_J615_OPT_IN, "0"));
+    assert(!t8122_25g83_board(profile));
+    assert(!fdt_setprop_string(profile, chosen, T8122_25G83_J615_OPT_IN, "11"));
+    assert(!t8122_25g83_board(profile));
+    assert(!fdt_setprop_string(profile, chosen, T8122_25G83_J615_OPT_IN, "1"));
+    assert(t8122_25g83_board(profile));
+    assert(!fdt_setprop_string(profile, 0, "compatible", "apple,j504"));
+    assert(!t8122_25g83_board(profile));
     return 0;
 }
