     .marker = "apple,j613-25g83-mapping-handoff",
@@ -1898,6 +1905,9 @@ static int dcp6_check_dt(void *dt, struct dcp6_dt *n)
 
     if (!dcp6_board_ok(dt))
         bail("not a %s device tree\n", soc->boards_desc);
