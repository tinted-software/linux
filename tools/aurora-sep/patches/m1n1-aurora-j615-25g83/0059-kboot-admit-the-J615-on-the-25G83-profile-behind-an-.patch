+static const char *const dcp_boards_j613[] = {"apple,j613", "apple,j615", NULL};
 
 static const struct dcp_soc dcp_soc_j613_25g83 = {
     .name = "J613-25G83",
     .chip = T8122,
     .compat = "apple,t8122",
     .boards = dcp_boards_j613,
-    .boards_desc = "J613",
+    .boards_desc = "J613/J615",
     .dcp_compat = "apple,t8122-dcp",
